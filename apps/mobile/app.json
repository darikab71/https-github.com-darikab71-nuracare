{
  "expo": {
    "name": "Nura",
    "slug": "nuracare",
    "version": "1.0.3",
    "orientation": "portrait",
    "scheme": "nuracare",
    "icon": "./assets/images/icon.png",
    "owner": "darikab71",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c8ef278f-9fa4-426b-b682-73785a5bea8d"
      }
    },
    "android": {
      "package": "com.darikab71.nuracaremobile",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/icon.png",
          "imageWidth": 150
        }
      ]
    ]
  }
}
